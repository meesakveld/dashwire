{
  "name": "@dashwire/server",
  "version": "0.22.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "public"
  ],
  "private": false,
  "scripts": {
    "build:dashboard": "cd dashboard && npm install && npm run build",
    "copy:dashboard": "rm -rf public && mkdir -p public && cp -r dashboard/out/* public/",
    "build:server": "tsc -p tsconfig.json && mkdir -p dist/db/drizzle && cp -r src/db/drizzle/* dist/db/drizzle/",
    "build": "npm run build:dashboard && npm run copy:dashboard && npm run build:server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@dashwire/core": "^0.1.0",
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.0.7",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.0",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}